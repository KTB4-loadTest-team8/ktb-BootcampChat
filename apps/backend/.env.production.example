# 운영(EC2) 배포용 .env 초안
#
# 사용법: 각 backend EC2에 최초 1회만 이 파일을 .env로 복사해서 CHANGE_ME_*
# 값들을 실제 값으로 채워두면 됩니다. deploy-jar / backend-cd.yml 둘 다
# 원격에 .env가 이미 있으면 덮어쓰지 않으므로, 그 이후엔 신경 쓸 필요 없습니다.
#
#   cp .env.production.example .env
#   $EDITOR .env
#
# 로컬 개발에는 이 파일이 아니라 .env.template을 쓰세요(make setup-env가
# 자동으로 처리합니다). 이 파일은 운영 전용입니다.
#
# Redis 관련 값(REDIS_HOST/PORT/PASSWORD)은 이번 범위에서 제외했습니다 —
# spring-boot-starter-data-redis가 의존성엔 있지만 실제 코드에서 쓰는
# 곳이 없어(세션/레이트리밋 모두 MongoDB 구현체 사용) 지금 단계 배포에는
# 불필요합니다. 나중에 Redis를 실제로 붙이게 되면 그때 추가하면 됩니다.

# ── 필수: 반드시 실제 값으로 교체 ────────────────────────────────

# openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# openssl rand -hex 16
ENCRYPTION_SALT=CHANGE_ME_32_HEX_CHARS

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET

# 같은 VPC 내부 private IP 사용 (public IP 아님)
MONGO_URI=mongodb://CHANGE_ME_MONGO_PRIVATE_IP:27017/bootcamp-chat

PORT=5001
WS_PORT=5002

OPENAI_API_KEY=sk-CHANGE_ME

# ── 선택: application.properties에 기본값이 있지만 운영 환경에서는 ──
# ── 명시적으로 지정하는 걸 권장하는 값들 ────────────────────────

# 기본값 "*"는 SecurityConfig가 부팅 시 보안 경고를 찍음. 프론트 배포 도메인으로 제한.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.yourdomain.com

# 위와 같은 이유로 Socket.IO 쪽도 프론트 도메인으로 제한 권장 (기본값 "*")
SOCKETIO_SERVER_ORIGIN=https://CHANGE_ME.yourdomain.com

# 운영에서 Swagger UI/OpenAPI 문서를 계속 열어둘지 여부 (기본값 true)
SWAGGER_ENABLED=false

# 기본값 when_authorized 유지 권장 — 인증 안 된 상태에서 헬스 상세 노출 방지
MANAGEMENT_HEALTH_SHOW_DETAILS=when_authorized

# local | gridfs — 현재 local 구현체만 있음(StoragePort/LocalStorage).
# Docker 배포에서는 컨테이너 재생성 시 uploads/가 유실되므로, 볼륨 마운트
# 없이 이 값을 local로 둘 경우 파일이 배포할 때마다 사라짐에 주의.
FILE_STORAGE_TYPE=local

# AI 멘션 기능 튜닝용, 특별한 이유 없으면 기본값 유지 가능
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7
